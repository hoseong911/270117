rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 하객 사진: 누구나 읽기, 이미지·8MB 이하만 업로드 허용
    match /photos/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
